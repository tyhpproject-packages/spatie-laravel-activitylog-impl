{
    "name": "tyhpdef/spatie-laravel-activitylog-impl",
    "description": "Implementation package for tyhpdef/spatie-laravel-activitylog. Require tyhpdef/spatie-laravel-activitylog, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.1.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/spatie-laravel-package-tools": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/spatie-laravel-activitylog"
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/laravel-activitylog": "5.1.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/spatie-laravel-package-tools": "@dev"
    }
}
